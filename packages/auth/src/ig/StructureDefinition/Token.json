{
  "resourceType": "StructureDefinition",
  "id": "atomic-auth-token",
  "url": "http://atomic-fhir.org/ig/auth/StructureDefinition/Token",
  "version": "1.0.0",
  "name": "AtomicAuthToken",
  "title": "Atomic Auth Access Token Profile",
  "status": "active",
  "publisher": "Atomic FHIR Team",
  "description": "Access token profile for Atomic FHIR authentication system with token details, expiration, and associated scopes",
  "fhirVersion": "4.0.1",
  "mapping": [
    {
      "identity": "rim",
      "uri": "http://hl7.org/v3",
      "name": "RIM Mapping"
    }
  ],
  "kind": "resource",
  "abstract": false,
  "type": "Basic",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Basic",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Basic",
        "path": "Basic",
        "short": "Atomic Authentication Token",
        "definition": "An access token record for the Atomic FHIR authentication system containing token details and associated permissions"
      },
      {
        "id": "Basic.code",
        "path": "Basic.code",
        "fixedCodeableConcept": {
          "coding": [
            {
              "system": "http://atomic-fhir.org/ig/auth/CodeSystem/resource-types",
              "code": "token",
              "display": "Access Token"
            }
          ]
        }
      },
      {
        "id": "Basic.extension",
        "path": "Basic.extension",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "url"
            }
          ],
          "ordered": false,
          "rules": "open"
        }
      },
      {
        "id": "Basic.extension:accessToken",
        "path": "Basic.extension",
        "sliceName": "accessToken",
        "short": "Access token value",
        "definition": "The access token string used for API authentication",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/access-token"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:refreshToken",
        "path": "Basic.extension",
        "sliceName": "refreshToken",
        "short": "Refresh token value",
        "definition": "The refresh token string used to obtain new access tokens",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/refresh-token"]
          }
        ]
      },
      {
        "id": "Basic.extension:tokenType",
        "path": "Basic.extension",
        "sliceName": "tokenType",
        "short": "Token type",
        "definition": "Type of token (typically 'Bearer')",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/token-type"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:expiresAt",
        "path": "Basic.extension",
        "sliceName": "expiresAt",
        "short": "Token expiration time",
        "definition": "Date and time when the token expires",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/expires-at"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:issuedAt",
        "path": "Basic.extension",
        "sliceName": "issuedAt",
        "short": "Token issue time",
        "definition": "Date and time when the token was issued",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/issued-at"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:scopes",
        "path": "Basic.extension",
        "sliceName": "scopes",
        "short": "Token scopes",
        "definition": "List of SMART on FHIR scopes granted to this token",
        "min": 0,
        "max": "*",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/token-scope"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:clientId",
        "path": "Basic.extension",
        "sliceName": "clientId",
        "short": "Associated client ID",
        "definition": "OAuth2 client ID that this token was issued to",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/associated-client-id"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:userId",
        "path": "Basic.extension",
        "sliceName": "userId",
        "short": "Associated user ID",
        "definition": "User ID that this token was issued for (if any)",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/associated-user-id"]
          }
        ]
      },
      {
        "id": "Basic.extension:active",
        "path": "Basic.extension",
        "sliceName": "active",
        "short": "Token active status",
        "definition": "Whether the token is active and can be used for authentication",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/active-status"]
          }
        ],
        "mustSupport": true
      }
    ]
  }
}