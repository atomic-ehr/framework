{
  "resourceType": "StructureDefinition",
  "id": "atomic-auth-client",
  "url": "http://atomic-fhir.org/ig/auth/StructureDefinition/Client",
  "version": "1.0.0",
  "name": "AtomicAuthClient",
  "title": "Atomic Auth OAuth2 Client Profile",
  "status": "active",
  "publisher": "Atomic FHIR Team",
  "description": "OAuth2/OIDC client profile for Atomic FHIR authentication system with client credentials, redirect URIs, and grant types",
  "fhirVersion": "4.0.1",
  "mapping": [
    {
      "identity": "rim",
      "uri": "http://hl7.org/v3",
      "name": "RIM Mapping"
    }
  ],
  "kind": "resource",
  "abstract": false,
  "type": "Basic",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Basic",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Basic",
        "path": "Basic",
        "short": "Atomic OAuth2 Client",
        "definition": "An OAuth2/OIDC client registration for the Atomic FHIR authentication system"
      },
      {
        "id": "Basic.code",
        "path": "Basic.code",
        "fixedCodeableConcept": {
          "coding": [
            {
              "system": "http://atomic-fhir.org/ig/auth/CodeSystem/resource-types",
              "code": "client",
              "display": "OAuth2 Client"
            }
          ]
        }
      },
      {
        "id": "Basic.extension",
        "path": "Basic.extension",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "url"
            }
          ],
          "ordered": false,
          "rules": "open"
        }
      },
      {
        "id": "Basic.extension:clientId",
        "path": "Basic.extension",
        "sliceName": "clientId",
        "short": "OAuth2 client identifier",
        "definition": "Unique client identifier for OAuth2 authentication",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/client-id"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:clientType",
        "path": "Basic.extension",
        "sliceName": "clientType",
        "short": "OAuth2 client type",
        "definition": "Client type: public or confidential",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/client-type"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:clientSecret",
        "path": "Basic.extension",
        "sliceName": "clientSecret",
        "short": "Client secret hash",
        "definition": "Hashed client secret for confidential clients",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/client-secret"]
          }
        ]
      },
      {
        "id": "Basic.extension:redirectUris",
        "path": "Basic.extension",
        "sliceName": "redirectUris",
        "short": "Redirect URIs",
        "definition": "List of valid redirect URIs for authorization flow",
        "min": 1,
        "max": "*",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/redirect-uri"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:grantTypes",
        "path": "Basic.extension",
        "sliceName": "grantTypes",
        "short": "Grant types",
        "definition": "List of OAuth2 grant types supported by this client",
        "min": 1,
        "max": "*",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/grant-type"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:responseTypes",
        "path": "Basic.extension",
        "sliceName": "responseTypes",
        "short": "Response types",
        "definition": "List of OAuth2 response types supported by this client",
        "min": 1,
        "max": "*",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/response-type"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:scopes",
        "path": "Basic.extension",
        "sliceName": "scopes",
        "short": "Allowed scopes",
        "definition": "List of scopes this client is allowed to request",
        "min": 0,
        "max": "*",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/client-scope"]
          }
        ]
      },
      {
        "id": "Basic.extension:active",
        "path": "Basic.extension",
        "sliceName": "active",
        "short": "Client active status",
        "definition": "Whether the client registration is active",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/active-status"]
          }
        ],
        "mustSupport": true
      }
    ]
  }
}