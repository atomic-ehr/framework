{
  "resourceType": "StructureDefinition",
  "id": "atomic-auth-login-session",
  "url": "http://atomic-fhir.org/ig/auth/StructureDefinition/LoginSession",
  "version": "1.0.0",
  "name": "AtomicAuthLoginSession",
  "title": "Atomic Auth Login Session Profile",
  "status": "active",
  "publisher": "Atomic FHIR Team",
  "description": "Login session profile for Atomic FHIR authentication system to track OAuth2 authorization flow state",
  "fhirVersion": "4.0.1",
  "mapping": [
    {
      "identity": "rim",
      "uri": "http://hl7.org/v3",
      "name": "RIM Mapping"
    }
  ],
  "kind": "resource",
  "abstract": false,
  "type": "Basic",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Basic",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Basic",
        "path": "Basic",
        "short": "Atomic Authentication Login Session",
        "definition": "A login session record for tracking OAuth2 authorization flow state in the Atomic FHIR authentication system"
      },
      {
        "id": "Basic.code",
        "path": "Basic.code",
        "fixedCodeableConcept": {
          "coding": [
            {
              "system": "http://atomic-fhir.org/ig/auth/CodeSystem/resource-types",
              "code": "login-session",
              "display": "Login Session"
            }
          ]
        }
      },
      {
        "id": "Basic.extension",
        "path": "Basic.extension",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "url"
            }
          ],
          "ordered": false,
          "rules": "open"
        }
      },
      {
        "id": "Basic.extension:sessionId",
        "path": "Basic.extension",
        "sliceName": "sessionId",
        "short": "Session identifier",
        "definition": "Unique identifier for this login session",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/session-id"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:clientId",
        "path": "Basic.extension",
        "sliceName": "clientId",
        "short": "OAuth2 client ID",
        "definition": "Client ID that initiated this authorization flow",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/session-client-id"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:redirectUri",
        "path": "Basic.extension",
        "sliceName": "redirectUri",
        "short": "Redirect URI",
        "definition": "Redirect URI to return to after authentication",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/session-redirect-uri"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:requestedScopes",
        "path": "Basic.extension",
        "sliceName": "requestedScopes",
        "short": "Requested scopes",
        "definition": "List of scopes requested by the client",
        "min": 0,
        "max": "*",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/requested-scope"]
          }
        ]
      },
      {
        "id": "Basic.extension:state",
        "path": "Basic.extension",
        "sliceName": "state",
        "short": "OAuth2 state parameter",
        "definition": "State parameter for CSRF protection",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/oauth2-state"]
          }
        ]
      },
      {
        "id": "Basic.extension:codeChallenge",
        "path": "Basic.extension",
        "sliceName": "codeChallenge",
        "short": "PKCE code challenge",
        "definition": "PKCE code challenge for public clients",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/pkce-code-challenge"]
          }
        ]
      },
      {
        "id": "Basic.extension:codeChallengeMethod",
        "path": "Basic.extension",
        "sliceName": "codeChallengeMethod",
        "short": "PKCE code challenge method",
        "definition": "PKCE code challenge method (plain or S256)",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/pkce-code-challenge-method"]
          }
        ]
      },
      {
        "id": "Basic.extension:launch",
        "path": "Basic.extension",
        "sliceName": "launch",
        "short": "SMART launch context",
        "definition": "SMART on FHIR launch context parameter",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/smart-launch-context"]
          }
        ]
      },
      {
        "id": "Basic.extension:userId",
        "path": "Basic.extension",
        "sliceName": "userId",
        "short": "Authenticated user ID",
        "definition": "User ID after successful authentication (if any)",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/authenticated-user-id"]
          }
        ]
      },
      {
        "id": "Basic.extension:isAuthenticated",
        "path": "Basic.extension",
        "sliceName": "isAuthenticated",
        "short": "Authentication status",
        "definition": "Whether the user has been successfully authenticated in this session",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/is-authenticated"]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Basic.extension:authorizationCode",
        "path": "Basic.extension",
        "sliceName": "authorizationCode",
        "short": "Authorization code",
        "definition": "Generated authorization code after successful authentication",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/authorization-code"]
          }
        ]
      },
      {
        "id": "Basic.extension:expiresAt",
        "path": "Basic.extension",
        "sliceName": "expiresAt",
        "short": "Session expiration time",
        "definition": "Date and time when this session expires",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://atomic-fhir.org/ig/auth/StructureDefinition/session-expires-at"]
          }
        ],
        "mustSupport": true
      }
    ]
  }
}