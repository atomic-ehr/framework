{
  "name": "@atomic-ehr/packages",
  "version": "0.1.0",
  "description": "Package loader and management for FHIR packages in atomic-ehr framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "fhir",
    "packages",
    "loader",
    "atomic-ehr",
    "package-management"
  ],
  "author": "Atomic EHR Team",
  "license": "MIT",
  "dependencies": {
    "@atomic-ehr/fhir-bridge": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@atomic-ehr/core": "workspace:*"
  }
}