{
  "name": "@atomic-ehr/server",
  "version": "0.1.0",
  "description": "HTTP server package for Atomic EHR framework with FHIR hooks integration",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "fhir",
    "healthcare",
    "server",
    "http",
    "hooks",
    "atomic",
    "bun"
  ],
  "author": "Atomic EHR Team",
  "license": "MIT",
  "dependencies": {
    "@atomic-ehr/core": "workspace:*",
    "@atomic-ehr/fhir-bridge": "workspace:*",
    "@atomic-ehr/packages": "workspace:*"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun build:ts",
    "build:ts": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "bun-types": "latest",
    "typescript": "^5.3.0"
  }
}