{
  "name": "smart-fhir-server-example",
  "version": "1.0.0",
  "description": "Example SMART on FHIR server with OAuth2 authentication",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir dist",
    "seed": "bun src/server.ts --seed",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atomic-fhir/core": "workspace:*",
    "@atomic-fhir/auth": "workspace:*",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "fhir",
    "smart-on-fhir",
    "oauth2",
    "authentication",
    "healthcare",
    "interoperability",
    "atomic-fhir"
  ],
  "author": "Atomic FHIR Team",
  "license": "MIT"
}